{
  "schema": 1,
  "name": "fish_drama3",
  "version": "0.1.0",
  "api_version": ">= 0.2.0",
  "entry": "fish_drama3_register",
  "registration_target": "gufo_fish_drama3",
  "depends": [],
  "platforms": [
    "linux",
    "windows"
  ],
  "providers": [
    {
      "id": "fish-drama3-tts",
      "capability": "speech_synthesis",
      "keys": [
        "safetensors:fish_omni",
        "safetensors:FishOmniModel",
        "safetensors:fish_qwen3_omni",
        "safetensors:FishQwen3OmniForCausalLM"
      ],
      "model_ids": [
        "fish-drama-3"
      ],
      "target": "gufo_fish_drama3_hip",
      "entry": "fish_drama3_provider_register",
      "serving": {
        "voices": true
      }
    }
  ],
  "targets": {
    "gufo_fish_drama3": {
      "requires": []
    },
    "gufo_fish_drama3_hip": {
      "requires": [
        "hip"
      ]
    },
    "fish_drama3_config_test": {
      "role": "test",
      "requires": [
        "testing"
      ]
    },
    "fish_drama3_test": {
      "role": "test",
      "requires": [
        "hip",
        "testing"
      ]
    }
  },
  "production_paths": {
    "include": [
      "**/*.cpp",
      "**/*.h",
      "**/*.hpp",
      "**/*.hip",
      "extension.*"
    ],
    "exclude": [
      "tests/"
    ]
  },
  "docs": {
    "title": "Fish Audio Drama-3",
    "inputs": "FP8/BF16 safetensors + DAC codec; text and reference voice audio",
    "guide": "README.md"
  },
  "tests": [
    {
      "target": "fish_drama3_config_test",
      "ctest": "fish_drama3.config",
      "check_pr": true,
      "windows_build": true
    }
  ],
  "test_labels": [
    "fish-drama3"
  ]
}
